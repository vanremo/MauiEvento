<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Class="MauiEvento.Views.CadastroEventoPage"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Cadastro de Evento"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Nome do Evento" FontSize="16"/>
            <Entry Placeholder="Ex: Google Developer Conference" Text="{Binding Nome}" />

            <Label Text="Data de Início" FontSize="16"/>
            <DatePicker Date="{Binding DataInicio}" />

            <Label Text="Data de Término" FontSize="16"/>
            <DatePicker Date="{Binding DataTermino}" />

            <Label FontSize="16" Text="Número de Participantes: {Binding NumeroParticipantes}" />
            <Stepper Value="{Binding NumeroParticipantes}" Minimum="1" Maximum="1000" Increment="1" />

            <Label Text="Local do Evento" FontSize="16"/>
            <Entry Placeholder="Ex: São Paulo Expo Center" Text="{Binding Local}" />

            <Label Text="Custo por Participante (R$)" FontSize="16"/>
            <Entry Placeholder="Ex: 250.00" Keyboard="Numeric" Text="{Binding CustoPorParticipante}" />

            <Button Text="Cadastrar Evento"
                    Clicked="OnCadastrarEventoClicked"
                    BackgroundColor="#6200EE"
                    TextColor="White"
                    CornerRadius="12"
                    FontSize="16"
                    HeightRequest="50"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>